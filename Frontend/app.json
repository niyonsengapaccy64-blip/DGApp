{
  "expo": {
    "name": "DG NOVA",
    "description": "DG E-Commerce & Course Academy. Learn • Explore • Grow.",
    "slug": "dg-nova",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/DGLoGo.jpg",
    "scheme": "dgnova",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "primaryColor": "#0284C7",
    "ios": {
      "icon": "./assets/DGLoGo.jpg",
      "bundleIdentifier": "com.dgretail.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.dgretail.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0B1120",
        "foregroundImage": "./assets/DGLoGo.jpg",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/DGLoGo.jpg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/DGLoGo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1120",
          "image": "./assets/DGLoGo.jpg",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
